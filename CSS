/* ==== GENERAL ===== */
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: 'Segoe UI', Arial, sans-serif; background: #f4f9f4; color: #333; line-height: 1.6; }
.container { max-width: 1100px; margin: 0 auto; padding: 0 20px; }

/* ===== HEADER ===== */
header { background: #2E8B57; color: white; text-align: center; padding: 30px 10px; }
header h1 { font-size: 2.5rem; }
header p { font-size: 1.1rem; font-style: italic; }

/* ===== NAV ===== */
nav { background: #3CB371; position: sticky; top: 0; z-index: 100; }
nav ul { display: flex; justify-content: center; flex-wrap: wrap; list-style: none; }
nav a { color: white; text-decoration: none; padding: 15px 20px; display: block; font-weight: bold; }
nav a:hover { background: #2E8B57; }

/* ===== SECTIONS ===== */
main { padding: 30px 0; }
section { margin-bottom: 50px; background: white; padding: 25px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
h2 { color: #2E8B57; border-bottom: 3px solid #3CB371; padding-bottom: 10px; margin-bottom: 15px; }
img { max-width: 100%; border-radius: 8px; margin-top: 15px; }

/* ===== CARDS + STATS ===== */
.stats { display: flex; justify-content: space-around; text-align: center; margin-top: 20px; }
.stats h3 { font-size: 2rem; color: #2E8B57; }
.card-container { display: flex; gap: 20px; flex-wrap: wrap; }
.card { flex: 1 1 300px; background: #e8f5e9; padding: 20px; border-radius: 8px; }

/* ===== BUTTONS ===== */
.btn { padding: 12px 25px; border: none; border-radius: 5px; cursor: pointer; font-weight: bold; margin: 10px 5px; text-decoration: none; display: inline-block; }
.btn-primary { background: #2E8B57; color: white; }
.btn-primary:hover { background: #1e5a3a; }
.btn-secondary { background: #FFA500; color: white; }

/* ===== FORM ===== */
form { background: #f0f0f0; padding: 20px; border-radius: 8px; margin-bottom: 20px; }
form input, form select { width: 100%; padding: 10px; margin: 8px 0 15px 0; border: 1px solid #ccc; border-radius: 4px; }
.donate-box { background: #e8f5e9; padding: 20px; border-radius: 8px; text-align: center; }

/* ===== FOOTER ===== */
footer { background: #333; color: white; text-align: center; padding: 20px; }

/* ===== RESPONSIVE - PART 2 ===== */
@media (max-width: 768px) {
    nav ul { flex-direction: column; }
    .stats { flex-direction: column; gap: 15px; }
    header h1 { font-size: 1.8rem; }
}
